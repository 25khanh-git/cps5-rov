{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CPS5: 1. Cài môi trường (setup_wsl)",
      "detail": "Chạy một lần: ROS 2, Gazebo, ArduSub SITL, plugin",
      "type": "process",
      "command": "bash",
      "args": [
        "-l",
        "scripts/setup_wsl.sh"
      ],
      "windows": {
        "command": "wsl.exe",
        "args": [
          "--cd",
          "${workspaceFolder}",
          "-e",
          "bash",
          "-l",
          "scripts/setup_wsl.sh"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "clear": true
      }
    },
